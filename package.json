{
  "name": "erm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "wrangler deploy",
    "start": "next start",
    "worker:dev": "wrangler dev src/workers/index.ts",
    "worker:deploy": "wrangler deploy",
    "db:create": "wrangler d1 create transfoerm",
    "db:migrate": "wrangler d1 execute transfoerm --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute transfoerm --file=./schema.sql --local",
    "start:local": "concurrently \"npm run dev\" \"npm run worker:dev\"",
    "test:all": "npm run test:local && npm run test:auth && npm run test:prod",
    "test:local": "tsx src/tests/api-test.ts",
    "test:auth": "tsx src/tests/auth-test.ts",
    "test:prod": "tsx src/tests/prod-test.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
